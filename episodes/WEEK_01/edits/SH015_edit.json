 "captions": [
  {
   "start": 1.2,
   "end": 3.0,
   "text": "I reported the broken *streetlamp*."
  },
  {
   "start": 4.0,
   "end": 7.0,
   "text": "Three years outside my window.\n*Dead*."
  },
  {
   "start": 7.8,
   "end": 9.6,
   "text": "They fixed it *overnight*."
  },
  {
   "start": 10.9,
   "end": 12.9,
   "text": "And I saw what stood *under* it."
  },
  {
   "start": 13.7,
   "end": 15.9,
   "text": "Every night. *Three years*."
  },
  {
   "start": 16.9,
   "end": 19.0,
   "text": "It had never been able\nto *see me* either."
  },
  {
   "start": 20.1,
   "end": 21.6,
   "text": "I turned my *light off*."
  }
 ],
 "cards": [
  {
   "start": 0.0,
   "end": 1.2,
   "text": "THEY FIXED\nTHE STREETLAMP."
  },
  {
   "start": 23.2,
   "end": 25.0,
   "text": "FAULT REPORTED BY RESIDENT.\nWE'RE SENDING SOMEONE ROUND."
  }
 ]
