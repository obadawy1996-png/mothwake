 "captions": [
  {
   "start": 1.2,
   "end": 2.9,
   "text": "Jun showed me his *night photos*."
  },
  {
   "start": 4.0,
   "end": 5.8,
   "text": "Night mode says: *hold still*."
  },
  {
   "start": 7.4,
   "end": 10.8,
   "text": "First photo. The room, *blurred*."
  },
  {
   "start": 10.9,
   "end": 13.5,
   "text": "One shape in the corner...\n*perfectly sharp*."
  },
  {
   "start": 14.9,
   "end": 16.6,
   "text": "Second photo. *Closer*."
  },
  {
   "start": 18.1,
   "end": 21.8,
   "text": "Third. Jun was the blur.\nIt was right *behind* him."
  },
  {
   "start": 22.9,
   "end": 26.1,
   "text": "It only moved when he moved.\nSo he *didn't*."
  },
  {
   "start": 27.1,
   "end": 29.9,
   "text": "The last photo was sharp.\n*Both* of them."
  },
  {
   "start": 30.0,
   "end": 33.6,
   "text": "Two Juns. Only one was\nholding the *phone*."
  }
 ],
 "cards": [
  {
   "start": 0.0,
   "end": 1.2,
   "text": "NIGHT MODE SAYS:\nHOLD STILL."
  },
  {
   "start": 33.7,
   "end": 34.8,
   "text": "TWO JUNS.\nONE PHONE."
  }
 ]
}