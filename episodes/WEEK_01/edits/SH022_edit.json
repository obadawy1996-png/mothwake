 "captions": [
  {
   "start": 1.2,
   "end": 3.5,
   "text": "How to survive *sleep paralysis*."
  },
  {
   "start": 4.2,
   "end": 5.9,
   "text": "Step one: *don't fight*."
  },
  {
   "start": 6.6,
   "end": 8.3,
   "text": "Two: *breathe slow*."
  },
  {
   "start": 9.4,
   "end": 11.5,
   "text": "Three: don't look at the *corner*."
  },
  {
   "start": 12.7,
   "end": 17.1,
   "text": "Four: if the bed dips,\ncount *its* breaths. Not yours."
  },
  {
   "start": 18.0,
   "end": 20.5,
   "text": "Five: stay still until *morning*."
  },
  {
   "start": 22.1,
   "end": 24.2,
   "text": "Morning. I *made it*."
  },
  {
   "start": 25.0,
   "end": 26.5,
   "text": "Then I read *who wrote it*."
  }
 ],
 "cards": [
  {
   "start": 0.0,
   "end": 1.2,
   "text": "STEP 1:\nDON'T FIGHT."
  },
  {
   "start": 26.8,
   "end": 30.4,
   "text": "THANK YOU FOR LYING SO STILL.\n\u2014 THE CORNER"
