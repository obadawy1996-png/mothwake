  {
   "start": 1.2,
   "end": 2.9,
   "text": "I wrote *hi*\non the bus window.",
   "style": "Cap"
  },
  {
   "start": 3.6,
   "end": 4.8,
   "text": "Something *wrote back*.",
   "style": "Cap"
  },
  {
   "start": 6.2,
   "end": 7.6,
   "text": "It knew *my name*.",
   "style": "Cap"
  },
  {
   "start": 8.6,
   "end": 9.9,
   "text": "From outside, I thought.",
   "style": "Cap"
  },
  {
   "start": 10.5,
   "end": 13.7,
   "text": "Then I realised...\nI could *read it*.",
   "style": "Cap"
  },
  {
   "start": 14.9,
   "end": 16.9,
   "text": "From outside,\nit'd be *backwards*.",
   "style": "Cap"
  },
  {
   "start": 17.7,
   "end": 19.8,
   "text": "It was written\n*from in here*.",
   "style": "Whisper"
  }
 ],
 "cards": [
  {
   "start": 0,
   "end": 1.2,
   "text": "SOMETHING WROTE BACK\nON MY BUS WINDOW."
