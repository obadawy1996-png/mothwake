 "captions": [
  {
   "start": 1.2,
   "end": 3.6,
   "text": "Same customer. *Every night*.",
   "style": "Cap"
  },
  {
   "start": 3.6,
   "end": 5.0,
   "text": "Same prescription.",
   "style": "Cap"
  },
  {
   "start": 5.3,
   "end": 8.3,
   "text": "Mrs Ferris. *Sleeping tablets*\nfor her husband.",
   "style": "Cap"
  },
  {
   "start": 9.8,
   "end": 12.0,
   "text": "Her husband\n*died nine years ago*.",
   "style": "Cap"
  },
  {
   "start": 13.1,
   "end": 15.7,
   "text": "'When he wakes, dear,\nhe *wanders*.'",
   "style": "Whisper"
  },
  {
   "start": 17.0,
   "end": 18.8,
   "text": "Every night *for a year*.",
   "style": "Cap"
  },
  {
   "start": 20.1,
   "end": 21.3,
   "text": "Tonight she *didn't come*.",
   "style": "Cap"
  },
  {
   "start": 22.1,
   "end": 23.4,
   "text": "Then *the bell*.",
   "style": "Cap"
  },
  {
   "start": 24.6,
   "end": 26.7,
   "text": "'My wife is *sleeping* now.'",
   "style": "Whisper"
  },
  {
   "start": 26.8,
   "end": 28.7,
   "text": "'You'll bring them\nto *flat eight*.'",
   "style": "Whisper"
  }
 ],
