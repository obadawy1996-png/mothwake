 "captions": [
  {
   "start": 1.2,
   "end": 3.0,
   "text": "Theo always wins\n*hide-and-seek*.",
   "style": "Cap"
  },
  {
   "start": 4.0,
   "end": 4.9,
   "text": "I learned *why*.",
   "style": "Cap"
  },
  {
   "start": 5.8,
   "end": 8.0,
   "text": "Nineteen, twenty. *Coming*.",
   "style": "Cap"
  },
  {
   "start": 8.9,
   "end": 10.4,
   "text": "He said: *shh*.",
   "style": "Whisper"
  },
  {
   "start": 11.1,
   "end": 12.3,
   "text": "It's *still counting*.",
   "style": "Whisper"
  },
  {
   "start": 12.7,
   "end": 17.4,
   "text": "*Three thousand, four hundred\nand eleven...*",
   "style": "Whisper"
  },
  {
   "start": 17.7,
   "end": 18.7,
   "text": "He wasn't *winning*.",
   "style": "Cap"
  },
  {
   "start": 19.3,
   "end": 21.5,
   "text": "He's been hiding.\n*Since last winter*.",
   "style": "Cap"
  },
  {
   "start": 22.5,
   "end": 23.6,
   "text": "*Ready or not*.",
   "style": "Whisper"
  }
