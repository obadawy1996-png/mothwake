 "captions": [
  {
   "start": 1.2,
   "end": 3.3,
   "text": "Our hallway light lasts\n*sixty seconds*.",
   "style": "Cap"
  },
  {
   "start": 4.3,
   "end": 5.0,
   "text": "There are *rules*.",
   "style": "Cap"
  },
  {
   "start": 6.0,
   "end": 7.3,
   "text": "*One*: press once.",
   "style": "Cap"
  },
  {
   "start": 8.4,
   "end": 9.4,
   "text": "*Two*: walk.",
   "style": "Cap"
  },
  {
   "start": 10.4,
   "end": 11.2,
   "text": "It hears *running*.",
   "style": "Cap"
  },
  {
   "start": 12.0,
   "end": 13.8,
   "text": "*Three*: if it goes out early...",
   "style": "Cap"
  },
  {
   "start": 14.5,
   "end": 16.5,
   "text": "stand still...\nand *say your number*.",
   "style": "Cap"
  },
  {
   "start": 17.6,
   "end": 18.6,
   "text": "*Nine*.",
   "style": "Whisper"
  },
  {
   "start": 19.8,
   "end": 21.3,
   "text": "*Four*: don't argue.",
   "style": "Cap"
  },
  {
   "start": 22.5,
   "end": 25.3,
   "text": "I didn't argue.\nSo *it kept it*.",
   "style": "Cap"
  },
  {
   "start": 25.5,
   "end": 28.5,
   "text": "Everyone who didn't argue\n*lives here*.",
   "style": "Cap"
  }
 ],
 "cards": [
  {
   "start": 0,
   "end": 1.2,
   "text": "OUR HALLWAY LIGHT\nHAS RULES."
  },
  {
   "start": 29.4,
   "end": 32.2,
   "text": "WHAT'S YOUR NUMBER?\nDON'T ARGUE."
