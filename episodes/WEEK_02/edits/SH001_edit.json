 "captions": [
  {
   "start": 1.2,
   "end": 2.4,
   "text": "*Dryer six* was running.",
   "style": "Cap"
  },
  {
   "start": 3.3,
   "end": 4.3,
   "text": "I hadn't put *anything* in.",
   "style": "Cap"
  },
  {
   "start": 5.4,
   "end": 7.2,
   "text": "3 a.m. *Just me*.",
   "style": "Cap"
  },
  {
   "start": 8.8,
   "end": 9.8,
   "text": "It gave me a *sock*.",
   "style": "Cap"
  },
  {
   "start": 10.8,
   "end": 12.6,
   "text": "Mine. From when\nI was *seven*.",
   "style": "Cap"
  },
  {
   "start": 13.9,
   "end": 15.9,
   "text": "Then *everything I ever lost*.",
   "style": "Cap"
  },
  {
   "start": 17.4,
   "end": 19.8,
   "text": "Then my *scarf*.\nThe one I was wearing.",
   "style": "Cap"
  },
  {
   "start": 21.1,
   "end": 22.8,
   "text": "I looked up.\n*Through the glass*.",
   "style": "Cap"
  },
  {
   "start": 24.2,
   "end": 26.0,
   "text": "She folds better\n*than I do*.",
   "style": "Whisper"
  }
 ],
 "cards": [
  {
   "start": 0,
   "end": 1.2,
   "text": "DRYER SIX WAS RUNNING.\nI PUT NOTHING IN."
  },
  {
   "start": 27.4,
   "end": 30.2,
   "text": "WHICH ONE OF US\nIS TYPING THIS?"
  }
 ],
