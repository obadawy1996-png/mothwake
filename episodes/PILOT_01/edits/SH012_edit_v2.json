 "captions": [
  {
   "start": 1.5,
   "end": 3.2,
   "text": "I sleep to *rain sounds*."
  },
  {
   "start": 4.0,
   "end": 6.4,
   "text": "Last night, I *paused* them."
  },
  {
   "start": 6.9,
   "end": 7.9,
   "text": "I paused it."
  },
  {
   "start": 8.5,
   "end": 10.0,
   "text": "The rain outside *stopped*."
  },
  {
   "start": 10.7,
   "end": 12.3,
   "text": "Play."
  },
  {
   "start": 12.5,
   "end": 13.4,
   "text": "Rain."
  },
  {
   "start": 13.45,
   "end": 14.6,
   "text": "Pause."
  },
  {
   "start": 14.7,
   "end": 15.8,
   "text": "*Nothing.*"
  },
  {
   "start": 16.0,
   "end": 18.2,
   "text": "Only *MY* window was wet."
  },
  {
   "start": 18.8,
   "end": 21.5,
   "text": "This time, the *tapping*\ndidn't stop."
  },
  {
   "start": 21.8,
   "end": 24.0,
   "text": "It was never a *recording*."
  }
 ],
 "cards": [
  {
   "start": 0.0,
   "end": 1.2,
   "text": "I PAUSED THE RAIN.\nIT STOPPED."
  },
