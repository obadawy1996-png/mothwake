 "captions": [
  {
   "start": 0.2,
   "end": 3.5,
   "text": "Theo has three rules\nabout his nightlight."
  },
  {
   "start": 3.8,
   "end": 7.2,
   "text": "Rule one, he said:\n\"It stays on.\"",
   "style": "Whisper"
  },
  {
   "start": 7.4,
   "end": 11.6,
   "text": "Rule two: \"If it flickers,\nlook at me. Not it.\"",
   "style": "Whisper"
  },
  {
   "start": 12.0,
   "end": 16.4,
   "text": "Rule three: \"If it goes out,\nnever turn on the big light.\"",
   "style": "Whisper"
  },
  {
   "start": 17.9,
   "end": 21.3,
   "text": "I'm the grown-up.\nI turned it on."
  },
  {
   "start": 21.6,
   "end": 25.4,
   "text": "They were all facing the nightlight.\nLike moths."
  },
  {
   "start": 26.6,
   "end": 30.5,
   "text": "It wasn't for Theo.\nIt kept them looking at it."
  },
  {
   "start": 30.6,
   "end": 33.8,
   "text": "And then he whispered:\n\"Now they'll look at you.\"",
   "style": "Whisper"
  }
 ],
