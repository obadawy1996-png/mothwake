 "captions": [
  {
   "start": 0.2,
   "end": 3.3,
   "text": "Theo has three rules\nabout his nightlight."
  },
  {
   "start": 3.6,
   "end": 6.2,
   "text": "\"One: it stays on.\"",
   "style": "Whisper"
  },
  {
   "start": 6.4,
   "end": 10.2,
   "text": "\"Two: if it flickers,\nlook at me. Not it.\"",
   "style": "Whisper"
  },
  {
   "start": 12.4,
   "end": 15.6,
   "text": "\"Three: if it goes out,\nnever turn on the big light.\"",
   "style": "Whisper"
  },
  {
   "start": 15.9,
   "end": 18.6,
   "text": "I'm the grown-up.\nI turned it on."
  },
  {
   "start": 19.0,
   "end": 22.8,
   "text": "They were all facing the nightlight.\nLike moths."
  },
  {
   "start": 24.4,
   "end": 28.0,
   "text": "It wasn't for Theo.\nIt kept them looking at it."
  },
  {
   "start": 28.6,
   "end": 31.0,
   "text": "\"Now they'll look at you.\"",
   "style": "Whisper"
  }
 ],
